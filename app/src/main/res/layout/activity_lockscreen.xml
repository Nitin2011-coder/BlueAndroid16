<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#0A1931">
    <ImageView android:id="@+id/lock_wallpaper" android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/wallpaper_blue" android:scaleType="centerCrop"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center" android:padding="24dp">
        <TextView android:id="@+id/lock_clock" android:text="10:45:00" android:textSize="82sp" android:textColor="#87CEEB" android:textStyle="bold"/>
        <EditText android:id="@+id/pin_input" android:hint="Enter PIN" android:inputType="numberPassword" android:textColor="#FFFFFF" android:layout_width="200dp" android:layout_height="wrap_content" android:layout_marginTop="30dp"/>
        <ImageView android:id="@+id/fingerprint_icon" android:src="@android:drawable/ic_lock_idle_lock" android:layout_width="70dp" android:layout_height="70dp" android:layout_marginTop="20dp"/>
        <Button android:id="@+id/btn_unlock" android:text="UNLOCK" android:backgroundTint="#0A1931" android:textColor="#87CEEB" android:layout_marginTop="16dp"/>
    </LinearLayout>
</FrameLayout>
