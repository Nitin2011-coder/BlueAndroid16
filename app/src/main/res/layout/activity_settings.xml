<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:orientation="vertical" android:padding="20dp" android:background="#0A1931" android:layout_width="match_parent" android:layout_height="match_parent">
    <TextView android:text="Customize Lock Screen" android:textColor="#87CEEB" android:textSize="22sp" android:textStyle="bold"/>
    <TextView android:text="Custom PIN" android:textColor="#FFFFFF" android:layout_marginTop="20dp"/>
    <EditText android:id="@+id/pin_input" android:inputType="numberPassword" android:textColor="#FFFFFF" android:backgroundTint="#87CEEB" android:layout_width="match_parent" android:layout_height="wrap_content"/>
    <Button android:id="@+id/btn_save_pin" android:text="Save PIN" android:backgroundTint="#87CEEB"/>
    <TextView android:text="Lock Wallpaper" android:textColor="#FFFFFF" android:layout_marginTop="20dp"/>
    <ImageView android:id="@+id/wallpaper_preview" android:layout_width="200dp" android:layout_height="300dp" android:src="@drawable/wallpaper_blue"/>
    <Button android:id="@+id/btn_change_wallpaper" android:text="Pick from Gallery" android:backgroundTint="#87CEEB"/>
    <Button android:id="@+id/btn_reset" android:text="Reset to Default Blue"/>
</LinearLayout>
